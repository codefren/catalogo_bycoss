meta {
  name: Login
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  username: {{username}}
  password: {{password}}
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.access_token);
    bru.setVar("refreshToken", res.body.refresh_token);
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("devuelve access y refresh", function () {
    expect(res.body.access_token).to.be.a("string");
    expect(res.body.refresh_token).to.be.a("string");
    expect(res.body.token_type).to.equal("bearer");
  });
}

docs {
  Login con usuario y contraseña (form-urlencoded). Guarda `accessToken`
  (JWT, 12 h) y `refreshToken` (7 d) en variables de ejecución.
}
