meta {
  name: Refresh
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refresh_token": "{{refreshToken}}"
  }
}

script:post-response {
  if (res.status === 200) {
    bru.setVar("accessToken", res.body.access_token);
    bru.setVar("refreshToken", res.body.refresh_token);
  }
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("rota el refresh token", function () {
    expect(res.body.refresh_token).to.be.a("string");
  });
}

docs {
  Renueva el access token. **Rotación**: el refresh usado queda revocado y se
  guarda el nuevo; volver a enviar el anterior devuelve `401`.
}
