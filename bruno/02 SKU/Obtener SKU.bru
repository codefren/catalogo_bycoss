meta {
  name: Obtener SKU
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/api/skus/{{skuEjemplo}}
  body: none
  auth: inherit
}

tests {
  test("status 200 (o 404 si no hay datos de ejemplo)", function () {
    expect([200, 404]).to.include(res.status);
  });
  if (res.status === 200) {
    test("una fila por almacén del mismo SKU", function () {
      for (const it of res.body.items) {
        expect(it.sku).to.equal(bru.getVar("skuEjemplo"));
      }
    });
  }
}

docs {
  Filas del SKU, una por almacén. Usa `skuEjemplo` (lo guarda **Listar SKUs**).
}
