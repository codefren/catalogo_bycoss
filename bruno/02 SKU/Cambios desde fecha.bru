meta {
  name: Cambios desde fecha
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/skus?actualizado_desde={{fechaDesde}}T00:00:00&orden=actualizado&limit=500
  body: none
  auth: inherit
}

params:query {
  actualizado_desde: {{fechaDesde}}T00:00:00
  orden: actualizado
  limit: 500
}

tests {
  test("status 200", function () {
    expect(res.status).to.equal(200);
  });
  test("sobre paginado", function () {
    expect(res.body.items).to.be.an("array");
    expect(res.body.count).to.equal(res.body.items.length);
    expect(res.body.count).to.be.at.most(res.body.limit);
  });
}

docs {
  Sincronización incremental: filas actualizadas desde una fecha/hora.
}
