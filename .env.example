# =============================================================================
#  Entorno del catálogo (docker-compose.yml). Copiar a .env:
#    cp .env.example .env
#  NO subas .env al repo (ponlo en .gitignore).
# =============================================================================

# ── Base de datos ────────────────────────────────────────────────────────────
POSTGRES_DB=catalogo
POSTGRES_USER=catalogo

# ── Contraseña — CÁMBIALA por una fuerte (>= 24 chars aleatorios) ─────────────
# Genera una con:  openssl rand -base64 24
POSTGRES_PASSWORD=cambia-esto-por-una-contraseña-fuerte

# ── Puerto publicado en el host (el que verá Databricks) ──────────────────────
# 5432 es el estándar. Si expones a internet, usa uno no estándar (p.ej. 54320)
# para reducir escaneos automáticos.
POSTGRES_PORT=5432

# ── API para terceros (servicio "api") ───────────────────────────────────────
# Claves de API válidas, separadas por coma. Una por cliente/tercero.
# Genera cada una con:  openssl rand -hex 32
API_KEYS=clave-de-ejemplo-cambiala,otra-clave-por-cliente

# Orígenes CORS permitidos, separados por coma. NUNCA "*" en producción.
# Déjalo vacío si solo se consume server-to-server (sin navegador).
CORS_ORIGINS=https://cliente-a.com,https://cliente-b.com

# Límite de peticiones por IP (formato slowapi: N/segundo|minuto|hora).
RATE_LIMIT=60/minute
