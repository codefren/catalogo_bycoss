# Copia a .env y rellena. NO se sube a git.
# (Las credenciales reales están hoy hardcodeadas en los scripts de Databricks
#  bycos_pg_exports/*.py; aquí van por entorno, no en el código.)

# ── Origen: SQL Server (Arsys) ──
SQLSERVER_HOST=82.223.100.253
SQLSERVER_PORT=4313
SQLSERVER_DB=S4T_BYCOS
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=pon-aqui-la-password

# ── Destino: PostgreSQL (catálogo que sirve la API) ──
# En docker-compose puedes usar el nombre de servicio 'postgres' y puerto 5432.
PG_HOST=postgres
PG_PORT=5432
PG_DATABASE=catalogo_bycoss
PG_USER=catalogo
PG_PASSWORD=pon-aqui-la-password
