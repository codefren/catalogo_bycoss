# Copia este archivo a .env y rellena tus credenciales.
# El .env NO se sube a git (está en .gitignore).

# URL base de la API (opcional; por defecto producción).
CATALOGO_BASE_URL=https://bycos.data4tex.com

# Usuario y contraseña de la Catálogo API (obligatorios).
CATALOGO_USER=bycos
CATALOGO_PASSWORD=pon-aqui-tu-contraseña
