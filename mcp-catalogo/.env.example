# Copia este archivo a .env y rellena tus credenciales.
# El .env NO se sube a git (está en .gitignore).

# ── Uso LOCAL (Claude Desktop lanza python server.py por stdio) ──────────────
# URL base de la API (opcional; por defecto producción).
CATALOGO_BASE_URL=https://bycos.data4tex.com

# Usuario y contraseña de la Catálogo API (obligatorios).
CATALOGO_USER=bycos
CATALOGO_PASSWORD=pon-aqui-tu-contraseña

# ── Uso REMOTO (desplegado en producción con docker compose) ─────────────────
# Estas van en el .env de la RAÍZ del proyecto (el que lee docker-compose), no
# en este archivo. Se documentan aquí como referencia:
#
#   CATALOGO_BASE_URL  -> en prod lo fija el compose a http://api:8000 (red interna).
#   CATALOGO_USER / CATALOGO_PASSWORD -> las mismas credenciales de la API.
#   MCP_API_KEY        -> token que los clientes deben enviar como
#                         'Authorization: Bearer <token>'. Genera uno con:
#                             openssl rand -hex 32
#
# Si MCP_API_KEY está vacío, el MCP NO exige token (solo para pruebas locales).
MCP_API_KEY=
